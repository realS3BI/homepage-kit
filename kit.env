# Project settings for homepage-kit. Do not put secrets here.
# Comments always go on their own line, never after a value.
# Values with spaces go in double quotes.
# Values that only apply to one machine belong in kit.local.env (not under version control).
# `npm run setup` asks for the first four values and writes them here.

# Short name of the website: lowercase letters, digits, hyphens.
# It is part of the names of the macOS services and the watchdog job.
SITE_SLUG=homepage

# Name of the OpenClaw skill. You call it with this name in the chat, for example /website.
# Empty = same as SITE_SLUG.
SKILL_NAME=

# Keywords that should also trigger the skill without the slash command.
# Example: SKILL_TRIGGERS="company website, our homepage"
SKILL_TRIGGERS=

# Local port of the live preview. Pick a separate port for each website on one machine.
PREVIEW_PORT=4321

# Optional: extra port for devices on the same Wi-Fi without Tailscale. Empty = off.
LAN_PORT=

# Domain of the live website, without https://. Example: musterbetrieb.at
SITE_DOMAIN=

# Optional: more domains that redirect to SITE_DOMAIN. Example: www.musterbetrieb.at
DOMAIN_ALIASES=

# SSH target of the VPS. Example: root@203.0.113.10
DEPLOY_HOST=

# Optional: target folder on the VPS. Empty = /opt/sites/<SITE_SLUG>
DEPLOY_PATH=

# Optional: recipient for alerts from the preview watchdog. Example: telegram:123456789
WATCHDOG_ALERT_TO=
